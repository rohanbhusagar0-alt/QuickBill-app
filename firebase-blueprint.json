{
  "entities": {
    "Merchant": {
      "title": "Merchant",
      "description": "Retail store merchant profile and business configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Merchant ID or Auth UID" },
        "shopName": { "type": "string", "description": "Shop trading name" },
        "name": { "type": "string", "description": "Merchant owner full name" },
        "phone": { "type": "string", "description": "10-digit Indian mobile number" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "gstin": { "type": "string", "description": "15-character GSTIN identifier" },
        "address": { "type": "string", "description": "Shop physical address with PIN code" },
        "upiId": { "type": "string", "description": "Default settlement UPI ID" },
        "preferredLanguage": { "type": "string", "description": "Selected language code" },
        "country": { "type": "string", "description": "Country code (IN)" },
        "region": { "type": "string", "description": "Data center region: asia-south1" }
      },
      "required": ["shopName", "phone", "country"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Store cashier or manager staff account for Role-Based Access Control",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "merchantId": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "manager", "cashier"] },
        "phone": { "type": "string" },
        "pin": { "type": "string" },
        "active": { "type": "boolean" },
        "lastLogin": { "type": "string" }
      },
      "required": ["name", "role"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Store customer ledger record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "merchantId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "totalUdhaar": { "type": "number" },
        "address": { "type": "string" },
        "trustScore": { "type": "number" },
        "loyaltyPoints": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "phone", "totalUdhaar"]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Atomic Udhaar debit or credit entry in customer ledger",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string", "enum": ["DEBIT", "CREDIT"] },
        "amount": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "billNo": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["customerId", "type", "amount", "balanceAfter"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory SKU and Kirana item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "merchantId": { "type": "string" },
        "name": { "type": "string" },
        "sellingPrice": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "mrp": { "type": "number" },
        "stockQty": { "type": "number" },
        "godownStock": { "type": "number" },
        "unit": { "type": "string" },
        "category": { "type": "string" },
        "barcode": { "type": "string" },
        "expiryDate": { "type": "string" },
        "lowStockAlert": { "type": "number" },
        "onlineAvailable": { "type": "boolean" }
      },
      "required": ["name", "sellingPrice", "stockQty", "unit"]
    },
    "Bill": {
      "title": "Bill",
      "description": "Sales invoice generated at POS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "merchantId": { "type": "string" },
        "billNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "grandTotal": { "type": "number" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "paymentMode": { "type": "string" },
        "status": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["billNumber", "grandTotal", "paymentMode", "status"]
    },
    "BankAccount": {
      "title": "BankAccount",
      "description": "Merchant bank settlement account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "merchantId": { "type": "string" },
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "ifsc": { "type": "string" },
        "isPrimary": { "type": "boolean" }
      },
      "required": ["bankName", "accountNumber", "ifsc"]
    }
  },
  "firestore": {
    "/merchants/{merchantId}": {
      "schema": "Merchant",
      "description": "Merchant store profile and billing details"
    },
    "/merchants/{merchantId}/staff/{staffId}": {
      "schema": "Staff",
      "description": "Store cashier or manager staff permissions"
    },
    "/merchants/{merchantId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer ledger records for Udhaar and Khata book"
    },
    "/merchants/{merchantId}/customers/{customerId}/ledger/{ledgerId}": {
      "schema": "LedgerEntry",
      "description": "Atomic Udhaar transactions"
    },
    "/merchants/{merchantId}/products/{productId}": {
      "schema": "Product",
      "description": "Inventory catalog and stock levels"
    },
    "/merchants/{merchantId}/bills/{billId}": {
      "schema": "Bill",
      "description": "Sales invoices and receipts"
    },
    "/merchants/{merchantId}/bank_accounts/{bankId}": {
      "schema": "BankAccount",
      "description": "Merchant bank payout and settlement accounts"
    }
  }
}
