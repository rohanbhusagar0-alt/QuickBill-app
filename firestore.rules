rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check test connection path
    match /test/{docId} {
      allow read, write: if true;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Store Merchants
    match /merchants/{merchantId} {
      allow get, list: if true;
      allow create, update: if isValidId(merchantId);
      allow delete: if isSignedIn();

      // Bills Collection
      match /bills/{billId} {
        allow get, list: if true;
        allow create, update: if isValidId(billId);
        allow delete: if isSignedIn();
      }

      // Customers & Udhaar Khata
      match /customers/{customerId} {
        allow get, list: if true;
        allow create, update: if isValidId(customerId);
        allow delete: if isSignedIn();

        // Customer Ledger Transactions
        match /ledger/{ledgerId} {
          allow get, list: if true;
          allow create, update: if isValidId(ledgerId);
          allow delete: if isSignedIn();
        }
      }

      // Products & Inventory
      match /products/{productId} {
        allow get, list: if true;
        allow create, update: if isValidId(productId);
        allow delete: if isSignedIn();
      }

      // Staff Accounts & Permissions
      match /staff/{staffId} {
        allow get, list: if true;
        allow create, update: if isValidId(staffId);
        allow delete: if isSignedIn();
      }

      // Bank Accounts & Settlement
      match /bank_accounts/{bankId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(bankId);
      }
    }
  }
}
